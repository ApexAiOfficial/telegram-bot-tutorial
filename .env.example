# Telegram Bot API token from BotFather.
# Replace this placeholder with your real token only in your local .env file.
BOT_TOKEN=replace-with-your-real-bot-token

# Comma-separated Telegram user IDs allowed to use admin-only commands.
ADMIN_IDS=

# Stage 11 public webhook deployment only. Polling examples may leave these blank.
WEBHOOK_URL=

# REQUIRED when using the public webhook example. Use 16-256 random letters/digits/underscore/hyphen characters and never commit the real secret.
WEBHOOK_SECRET=

# Local default; PaaS providers commonly inject PORT and the code reads that value.
PORT=8443
